  provider                 PaymentProvider  @default(MOCK)
  mockReference            String           @unique @map("mock_reference") @db.VarChar(64)
  status                   PaymentStatus    @default(PENDING)
  currency                 String           @default("TRY") @db.Char(3)
  amountMinor              Int              @map("amount_minor")
